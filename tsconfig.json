{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "Resources/Private/JavaScript/**/*.ts",
    "Resources/Private/JavaScript/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "Resources/Public"
  ]
}
